FROM node:20-alpine AS build
WORKDIR /src
COPY apps/web/package.json apps/web/package-lock.json* ./apps/web/
WORKDIR /src/apps/web
RUN npm install
COPY apps/web .
RUN npm run build

FROM node:20-alpine
WORKDIR /app
RUN npm install -g serve
COPY --from=build /src/apps/web/dist ./dist
EXPOSE 3000
CMD ["serve", "-s", "dist", "-l", "3000"]
