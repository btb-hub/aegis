# Native local development; Postgres from make dev-db.
DATABASE_URL=postgres://aegis:aegis@localhost:5432/aegis?sslmode=disable
DEV_AUTH_ENABLED=true
DEV_AUTH_DEFAULT_ROLE=admin
DEV_AUTH_EMAIL=dev@localhost
# Local defaults: http://localhost:3000, API :8080. Change these in Settings.
# To exercise bootstrap, disable dev auth and supply AEGIS_BOOTSTRAP_TOKEN
# generated from at least 32 random bytes.
