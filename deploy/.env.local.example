# Core — use this template when running api/worker/web on the host (make setup-local).
# Postgres must be reachable at localhost (make dev-db starts it in Docker).
DATABASE_URL=postgres://aegis:aegis@localhost:5432/aegis?sslmode=disable
SESSION_SECRET=change-me-session-secret
WEBHOOK_SECRET=change-me-webhook-secret
PUBLIC_URL=http://localhost:3000
HTTP_ADDR=:8080
SESSION_TTL=168h

# OIDC redirect URLs must match PUBLIC_URL origin (web app on :3000 with Vite proxy, or nginx in Docker).
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URL=http://localhost:3000/auth/google/callback

# Slack OIDC
SLACK_OIDC_CLIENT_ID=
SLACK_OIDC_CLIENT_SECRET=
SLACK_OIDC_REDIRECT_URL=http://localhost:3000/auth/slack/callback

# eXpress OIDC
EXPRESS_OIDC_ISSUER=
EXPRESS_OIDC_CLIENT_ID=
EXPRESS_OIDC_CLIENT_SECRET=
EXPRESS_OIDC_REDIRECT_URL=http://localhost:3000/auth/express/callback

# Integrations (optional until setup wizard)
ALERT_FINGERPRINT_LABELS=alertname,team
INCIDENT_DEDUP_WINDOW=24h
ESCALATION_TIMEOUT=15m
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
EXPRESS_BOT_ID=
EXPRESS_BOT_HOST=
EXPRESS_BOT_SECRET=
