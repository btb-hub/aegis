FROM golang:1.25-alpine AS build
WORKDIR /src
COPY pkg/ pkg/
COPY apps/api/ apps/api/
WORKDIR /src/apps/api
ENV GOWORK=off
RUN CGO_ENABLED=0 go build -o /api ./cmd/api

FROM alpine:3.20
WORKDIR /app
COPY --from=build /api /app/api
COPY pkg/i18n/messages /app/pkg/i18n/messages
EXPOSE 8080
CMD ["/app/api"]
