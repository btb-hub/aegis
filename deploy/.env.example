# Deployment only. Configure application settings in the admin Settings page.
DATABASE_URL=postgres://aegis:aegis@postgres:5432/aegis?sslmode=disable
# Fresh installations only: generate from at least 32 random bytes (openssl rand -hex 32).
# Submit this through /bootstrap, never through a URL.
AEGIS_BOOTSTRAP_TOKEN=
DEV_AUTH_ENABLED=false
DEV_AUTH_DEFAULT_ROLE=admin
DEV_AUTH_EMAIL=dev@localhost
# Existing installations: import the original env before starting updated services.
# See docs/configuration-migration.md.
