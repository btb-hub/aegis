# Core — Docker Compose full stack (make up).
# For native dev on the host, use deploy/.env.local.example instead (make setup-local).
DATABASE_URL=postgres://aegis:aegis@postgres:5432/aegis?sslmode=disable
SESSION_SECRET=change-me-session-secret
WEBHOOK_SECRET=change-me-webhook-secret
PUBLIC_URL=http://localhost:8080
HTTP_ADDR=:8080
SESSION_TTL=168h

# Comma-separated emails forced to admin on OIDC login (always-on)
ADMIN_EMAILS=

# Google OIDC
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URL=http://localhost:8080/auth/google/callback

# Slack OIDC
SLACK_OIDC_CLIENT_ID=
SLACK_OIDC_CLIENT_SECRET=
SLACK_OIDC_REDIRECT_URL=http://localhost:8080/auth/slack/callback

# eXpress OIDC
EXPRESS_OIDC_ISSUER=
EXPRESS_OIDC_CLIENT_ID=
EXPRESS_OIDC_CLIENT_SECRET=
EXPRESS_OIDC_REDIRECT_URL=http://localhost:8080/auth/express/callback

# Local dev auth (never enable in production; localhost PUBLIC_URL only)
DEV_AUTH_ENABLED=false
DEV_AUTH_DEFAULT_ROLE=admin
DEV_AUTH_EMAIL=dev@localhost

# Integrations (optional until setup wizard)
ALERT_FINGERPRINT_LABELS=alertname,team
INCIDENT_DEDUP_WINDOW=24h
ESCALATION_TIMEOUT=15m
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
EXPRESS_BOT_ID=
EXPRESS_BOT_HOST=
EXPRESS_BOT_SECRET=
